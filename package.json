{
  "name": "@harmonia-vault/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.5.2",
  "cloudflare": {
    "bindings": {
      "EMAIL_FROM": {
        "description": "填写已验证发信域名下的邮箱，例如 noreply@example.com。"
      },
      "ALLOW_REGISTRATION": {
        "description": "允许其他人注册此服务。"
      },
      "REQUIRE_EMAIL_VERIFICATION": {
        "description": "注册时验证邮箱。"
      }
    }
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/node.js",
    "worker:types": "WRANGLER_SEND_METRICS=false wrangler types src/worker-env.d.ts --include-runtime=false --strict-vars=false",
    "worker:test": "tsx --test test/worker.test.ts"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "hash-wasm": "4.12.0",
    "nodemailer": "10.0.13",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261002.1",
    "@types/node": "24.6.2",
    "@types/nodemailer": "7.0.4",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.1",
    "miniflare": "4.20260730.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "wrangler": "4.147.0"
  }
}
